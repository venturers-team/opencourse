{
  "name": "opencourse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm --filter @opencourse/content build && node packages/content/dist/machine-check/cli.js",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "course": "pnpm --filter @opencourse/pipeline build && node packages/pipeline/dist/cli.js",
    "ops": "pnpm --filter @opencourse/pipeline build && node packages/pipeline/dist/ops-cli.js",
    "status": "pnpm ops status",
    "metrics": "pnpm ops metrics",
    "board": "pnpm ops board",
    "board:check": "pnpm ops board:check",
    "e2e": "node e2e/run.mjs",
    "e2e:backend": "playwright test --config e2e/backend.config.ts"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "@playwright/test": "^1.48.2"
  }
}
